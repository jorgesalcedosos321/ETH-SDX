    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>DLE_Scheduled_Send_Compact</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <deprecated>false</deprecated>
    <description>Queue of donor-lifecycle emails to send at a future time. A row is created Pending by DLE_ScheduledEmailService; DLE_ScheduledSendScheduler (hourly Schedulable) claims due rows and DLE_ScheduledSendProcessor (Queueable) runs each through the normal DLE_EmailDispatchService.sendEmail pipeline. Rows are engine-managed; Business Analysts read them and may Cancel a Pending row from the Donor Lifecycle Engine app.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
