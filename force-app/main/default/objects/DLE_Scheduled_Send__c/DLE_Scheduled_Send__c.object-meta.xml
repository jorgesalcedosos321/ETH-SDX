    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <label>DLE Scheduled Send</label>
    <nameField>
        <displayFormat>DLE-SS-{0000000000}</displayFormat>
        <label>Scheduled Send Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>DLE Scheduled Sends</pluralLabel>
